# ==============================================================================
# Cloud Resource Scheduling & Multi-Channel Alert System Configuration
# ==============================================================================

# Application & Security
FLASK_ENV=development
SECRET_KEY=dev-cloud-scheduler-super-secret-key-change-in-production-2026
DEBUG=True
PORT=5000
WEBHOOK_BASE_URL=http://localhost:5000

# Database Configuration (MySQL / SQLAlchemy)
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/cloud_scheduler
# If set to True, will automatically fall back to local SQLite if MySQL connection fails
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=sqlite:///cloud_scheduler.db

# AWS Cloud Integration
# When USE_MOCK_AWS=True, simulated EC2 instances are used for offline testing/demos.
USE_MOCK_AWS=True
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Task Scheduler (APScheduler)
# Audit interval in seconds (default 60 seconds)
SCAN_INTERVAL_SECONDS=60
# Grace period in minutes before automated shutdown of unacknowledged instances
GRACE_PERIOD_MINUTES=30
# Action token TTL in seconds (default 15 minutes = 900 seconds)
ACTION_TOKEN_TTL_SECONDS=900

# FinOps Cost Model (Hourly rate per instance in USD for simulated savings calculation)
HOURLY_COST_PER_INSTANCE_USD=0.096
USD_TO_INR_RATE=83.50

# Multi-Channel Alert Gateway: Twilio (SMS & WhatsApp)
# Set your Twilio credentials. If left as demo values, mock delivery logs will be generated.
TWILIO_ACCOUNT_SID=AC_mock_twilio_account_sid_for_demo
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_for_demo
TWILIO_PHONE_NUMBER=+12015550123
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Admin Alert Notification Recipients
ALERT_PHONE_NUMBER=+12015550199
ALERT_WHATSAPP_NUMBER=whatsapp:+12015550199
ALERT_EMAIL_RECIPIENT=cloud-admin@example.com

# Multi-Channel Alert Gateway: Email (SMTP)
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=cloud-alerts@example.com
SMTP_FROM_NAME="Cloud Resource Scheduler"
